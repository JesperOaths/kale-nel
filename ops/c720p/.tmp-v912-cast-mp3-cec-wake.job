set -e
V=/home/jespern/c720p-home-hub/venvs/pychromecast
OUT=/opt/homeassistant/config/www/c720p-cast-wake.mp3
if command -v ffmpeg >/dev/null 2>&1; then
  ffmpeg -loglevel error -y -f lavfi -i anullsrc=r=44100:cl=stereo -t 12 -q:a 9 -acodec libmp3lame "$OUT"
else
  echo NO_FFMPEG
  exit 6
fi
ls -l "$OUT"
URL=http://192.168.178.141:8123/local/c720p-cast-wake.mp3
curl -sS -I --max-time 4 "$URL" | head -20 || true
"$V/bin/python" - <<'PY'
import time, pychromecast
url="http://192.168.178.141:8123/local/c720p-cast-wake.mp3"
casts,browser=pychromecast.get_listed_chromecasts(friendly_names=["Living Room TV"],discovery_timeout=12)
try:
    print("FOUND",[(c.name,c.cast_info.host,c.cast_info.port) for c in casts],flush=True)
    if not casts: raise SystemExit(4)
    cc=casts[0]
    cc.wait(timeout=12)
    mc=cc.media_controller
    mc.play_media(url,"audio/mpeg",title="C720P CEC wake",stream_type="BUFFERED")
    active=False
    for i in range(1,16):
        time.sleep(1)
        mc.update_status()
        st=str(mc.status.player_state or "")
        print("MEDIA_POLL",i,st,mc.status.current_time,flush=True)
        if st in ("PLAYING","BUFFERING","PAUSED"):
            active=True
            break
    print("MEDIA_ACTIVE",active,flush=True)
    time.sleep(7)
finally:
    try: pychromecast.discovery.stop_discovery(browser)
    except Exception: pass
PY
echo ===TV_WAKE_POLL===
awake=0
for i in $(seq 1 30); do
  p6466=0; p8009=0
  timeout 1 bash -lc "</dev/tcp/192.168.178.169/6466" >/dev/null 2>&1 && p6466=1 || true
  timeout 1 bash -lc "</dev/tcp/192.168.178.169/8009" >/dev/null 2>&1 && p8009=1 || true
  echo "POLL_$i 6466=$p6466 8009=$p8009"
  if [ "$p6466" = 1 ] || [ "$p8009" = 1 ]; then awake=1; break; fi
  sleep 1
done
echo "TV_NETWORK_AWAKE=$awake"
echo ===TV_STATUS===
/home/jespern/c720p-home-hub/bin/c720p-grundig-wifi-control.sh status || true
if [ "$awake" = 1 ]; then
  echo ===HDMI3===
  /home/jespern/c720p-home-hub/bin/c720p-grundig-wifi-control.sh key TV_INPUT_HDMI_3 || true
  sleep 4
fi
echo ===HTS_AFTER===
curl -sS --max-time 8 http://127.0.0.1:8789/ht-e6500/power-state || true
bluetoothctl info 8C:C8:CD:8B:06:3B || true
echo RESULT=V912_CAST_MP3_CEC_WAKE_DONE