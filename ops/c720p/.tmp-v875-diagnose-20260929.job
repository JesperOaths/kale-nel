set -e; echo ===TV_BEFORE===; curl -fsS --max-time 10 http://127.0.0.1:8789/grundig-tv/power-state || true; echo; adb -s 993e96d0 logcat -c || true; echo ===SEND_GRUNDIG_POWER===; adb -s 993e96d0 shell am broadcast -n com.bruis.s5irbridge/.IrReceiver -a com.bruis.s5irbridge.SEND --es device grundig_tv --es command grundig_power; sleep 5; echo ===TV_AFTER===; curl -fsS --max-time 10 http://127.0.0.1:8789/grundig-tv/power-state || true; echo; echo ===LOGCAT===; adb -s 993e96d0 logcat -d -v time 2>&1 | grep -i -E 'S5IRBridge|Unknown|IR send failed|Sent verified' | tail -80 || true; echo RESULT=GRUNDIG_IR_CROSSCHECK_DONE