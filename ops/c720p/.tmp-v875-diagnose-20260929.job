set -e; echo ===CEC_DEVICES===; ls -l /dev/cec* 2>&1 || true; echo ===CEC_SYSFS===; find /sys/class/cec -maxdepth 2 -type l -o -type f 2>/dev/null | head -80 || true; echo ===CEC_TOOLS===; command -v cec-ctl || true; command -v cec-client || true; echo ===DRM_CONNECTORS===; ls -1 /sys/class/drm/*/status 2>/dev/null | while read f; do printf '%s=' "$f"; cat "$f"; done; if command -v cec-ctl >/dev/null 2>&1 && [ -e /dev/cec0 ]; then echo ===CEC_INFO===; timeout 12 cec-ctl -d0 --show-topology 2>&1 || true; fi; echo RESULT=CEC_CAPABILITY_INSPECTED