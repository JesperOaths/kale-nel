cat >/tmp/v906_pairwake.py <<'PYEOF'
import asyncio, json, socket, time
from androidtvremote2 import AndroidTVRemote
HOST="192.168.178.169"
CERT="/home/jespern/c720p-home-hub/state/grundig_androidtv_cert.pem"
KEY="/home/jespern/c720p-home-hub/state/grundig_androidtv_key.pem"
def port(p,timeout=1.0):
    s=socket.socket(); s.settimeout(timeout)
    try: s.connect((HOST,p)); return True
    except Exception: return False
    finally: s.close()
async def main():
    out={"before_6466":port(6466),"before_6467":port(6467)}
    r=AndroidTVRemote("C720P Grundig WiFi Remote",CERT,KEY,HOST,enable_voice=False)
    try:
        nm=await asyncio.wait_for(r.async_get_name_and_mac(),timeout=8)
        out["get_name_mac_ok"]=True; out["name_mac"]=nm
    except Exception as e:
        out["get_name_mac_ok"]=False; out["name_mac_error"]=repr(e)
    for i in range(1,9):
        await asyncio.sleep(0.75)
        out[f"poll_{i}_6466"]=port(6466)
    print(json.dumps(out,indent=2,sort_keys=True))
asyncio.run(main())
PYEOF
"$PY" /tmp/v906_pairwake.py
echo RESULT=V906_PAIRING_WAKE_PROBE_DONE