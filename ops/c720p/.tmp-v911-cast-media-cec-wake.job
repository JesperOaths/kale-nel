set -e
V=/home/jespern/c720p-home-hub/venvs/pychromecast
[ -x "$V/bin/python" ]
IP=$(ip -4 -o addr show dev wlp1s0 | awk '$3=="inet"{print $4;exit}' | cut -d/ -f1)
D=/tmp/v911-cast
mkdir -p "$D"
"$V/bin/python" - <<'PY'
import wave, struct
p="/tmp/v911-cast/silence.wav"
with wave.open(p,"wb") as w:
    w.setnchannels(1); w.setsampwidth(2); w.setframerate(8000)
    w.writeframes(struct.pack("<h",0)*8000*12)
print(p)
PY
cd "$D"
python3 -m http.server 18090 --bind "$IP" >/tmp/v911-http.log 2>&1 &
HPID=$!
trap 'kill $HPID 2>/dev/null || true' EXIT
sleep 1
echo "MEDIA_URL=http://$IP:18090/silence.wav"
"$V/bin/python" - <<PY
import time, pychromecast
url="http://$IP:18090/silence.wav"
casts,browser=pychromecast.get_listed_chromecasts(friendly_names=["Living Room TV"], discovery_timeout=12)
try:
    print("FOUND",[(c.name,c.cast_info.host,c.cast_info.port) for c in casts],flush=True)
    if not casts: raise SystemExit(4)
    cc=casts[0]
    cc.wait(timeout=12)
    mc=cc.media_controller
    mc.play_media(url,"audio/wav",title="C720P wake probe")
    try: mc.block_until_active(timeout=12)
    except Exception as e: print("ACTIVE_WAIT",repr(e),flush=True)
    print("CAST_STATUS",cc.status,flush=True)
    print("MEDIA_STATUS",mc.status,flush=True)
    time.sleep(8)
finally:
    try: pychromecast.discovery.stop_discovery(browser)
    except Exception: pass
PY
echo ===TV_WAKE_POLL===
awake=0
for i in $(seq 1 30); do
  p6466=0; p8009=0
  timeout 1 bash -lc "</dev/tcp/192.168.178.169/6466" >/dev/null 2>&1 && p6466=1 || true
  timeout 1 bash -lc "</dev/tcp/192.168.178.169/8009" >/dev/null 2>&1 && p8009=1 || true
  echo "POLL_$i 6466=$p6466 8009=$p8009"
  if [ "$p6466" = 1 ] || [ "$p8009" = 1 ]; then awake=1; break; fi
  sleep 1
done
echo "TV_NETWORK_AWAKE=$awake"
echo ===TV_STATUS===
/home/jespern/c720p-home-hub/bin/c720p-grundig-wifi-control.sh status || true
if [ "$awake" = 1 ]; then
  echo ===HDMI3===
  /home/jespern/c720p-home-hub/bin/c720p-grundig-wifi-control.sh key TV_INPUT_HDMI_3 || true
  sleep 4
fi
echo ===HTS===
curl -sS --max-time 8 http://127.0.0.1:8789/ht-e6500/power-state || true
bluetoothctl info 8C:C8:CD:8B:06:3B || true
echo RESULT=V911_CAST_MEDIA_CEC_WAKE_DONE