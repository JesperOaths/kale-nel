set -e; BASE=https://raw.githubusercontent.com/JesperOaths/kale-nel/main/ops/c720p; curl -fsSL "$BASE/patch-c720p-controlplane-watchdog-v919.py" -o /tmp/patch-c720p-controlplane-watchdog-v919.py; python3 /tmp/patch-c720p-controlplane-watchdog-v919.py; systemctl --user is-active c720p-agent-runner.service c720p-security-tunnel.service c720p-no-suspend.service; systemctl --user is-enabled c720p-controlplane-watchdog.timer c720p-no-suspend.service; echo RESULT=V919_CONTROLPLANE_WATCHDOG_VERIFIED