set -e
BASE=https://raw.githubusercontent.com/JesperOaths/kale-nel/main/ops/c720p
curl -fsSL "$BASE/patch-s5-merge-grundig-profile-v899.py" -o /tmp/patch-s5-merge-grundig-profile-v899.py
python3 /tmp/patch-s5-merge-grundig-profile-v899.py
systemctl --user restart ht-e6500-surround.service c720p-bluetooth-helper.service
sleep 2
adb -s 993e96d0 logcat -c
echo ===TV_BEFORE===
curl -sS http://127.0.0.1:8789/grundig-tv/power-state; echo
echo ===SEND_GRUNDIG_POWER===
adb -s 993e96d0 shell am broadcast -n com.bruis.s5irbridge/.IrReceiver -a com.bruis.s5irbridge.SEND --es device grundig_tv --es command grundig_power
for i in $(seq 1 15); do
  sleep 1
  st=$(curl -sS http://127.0.0.1:8789/grundig-tv/power-state || true)
  echo "TV_POLL_$i=$st"
  echo "$st" | grep -q '"state": "on"' && break || true
done
echo ===IR_LOG===
adb -s 993e96d0 logcat -d -v time | grep -F 'S5IRBridge' | tail -60 || true
echo ===HDMI3_IF_ON===
curl -sS --max-time 20 -X POST http://127.0.0.1:8789/grundig-tv/hdmi3-fast || true; echo
echo ===TV_FINAL===
curl -sS http://127.0.0.1:8789/grundig-tv/power-state; echo
echo RESULT=V899_MERGE_TVTEST_DONE