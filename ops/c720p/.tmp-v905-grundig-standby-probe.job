set -e
H=192.168.178.169
echo ===PORTS===
for p in 6466 6467 8008 8009 8443 9000; do timeout 1 bash -lc "</dev/tcp/$H/$p" >/dev/null 2>&1 && echo "OPEN $p" || echo "CLOSED $p"; done
echo ===HTTP_8008===
for u in /setup/eureka_info /setup/eureka_info?params=name,build_info,device_info,net /ssdp/device-desc.xml /apps /setup/configured_networks; do
  echo "---$u"
  curl -sS --max-time 3 -D - "http://$H:8008$u" -o /tmp/v905.out || true
  head -c 1400 /tmp/v905.out 2>/dev/null || true; echo
done
echo ===HTTPS_8443===
for u in /setup/eureka_info /setup/eureka_info?params=name,build_info,device_info,net /ssdp/device-desc.xml /apps; do
  echo "---$u"
  curl -k -sS --max-time 3 -D - "https://$H:8443$u" -o /tmp/v905.out || true
  head -c 1400 /tmp/v905.out 2>/dev/null || true; echo
done
echo ===MDNS===
timeout 6 avahi-browse -rt _androidtvremote2._tcp 2>/dev/null | head -100 || true
timeout 6 avahi-browse -rt _googlecast._tcp 2>/dev/null | head -160 || true
echo RESULT=V905_GRUNDIG_STANDBY_PROBE_DONE