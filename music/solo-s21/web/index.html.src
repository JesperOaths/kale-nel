<!doctype html>
<html lang="en">
<!-- GEJAST_PAGE_VERSION = 'v817' -->
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b1120">
<meta name="robots" content="noindex">
<title>Tune Rush • Solo on S21</title>
<link rel="stylesheet" href="/style.css">
<script src="/app.js" defer></script>
</head>
<body>
<header class="mast">
  <a class="brand" href="https://kalenel.nl/music/">KALENEL<span>.</span></a>
  <span class="edition">TUNE RUSH <b>SOLO</b></span>
  <span id="server-status" class="online" role="status" aria-live="polite">Checking S21 connection…</span>
</header>
<main class="shell">
<section id="welcome" class="welcome">
 <div class="intro">
  <p class="eyebrow">YOUR PRIVATE MUSIC CHALLENGE • POWERED BY S21</p>
  <h1>One player.<br><em>Every song a challenge.</em></h1>
  <p class="subline">Your laptop plays the clues. Your Samsung S21 selects the music, keeps score and runs the entire game service on Wi-Fi.</p>
  <div class="feature-row"><span>♫ Cached songs</span><span>⚡ Seven growing clues</span><span>◉ Solo play</span></div>
 </div>
 <form id="start-form" class="setup panel">
  <div class="setup-heading"><div><span class="eyebrow">01 / YOUR MIX</span><h2>Set the soundtrack</h2></div><span class="mix-icon" aria-hidden="true">♫</span></div>
  <fieldset><legend>Genres</legend>
  <div class="chip-grid">
   <label><input type="checkbox" name="genre" value="pop" checked><span>Pop</span></label>
   <label><input type="checkbox" name="genre" value="rock" checked><span>Rock</span></label>
   <label><input type="checkbox" name="genre" value="dance"><span>Dance</span></label>
   <label><input type="checkbox" name="genre" value="electronic"><span>Electronic</span></label>
   <label><input type="checkbox" name="genre" value="hiphop"><span>Hip-hop</span></label>
   <label><input type="checkbox" name="genre" value="indie"><span>Indie</span></label>
   <label><input type="checkbox" name="genre" value="disco"><span>Disco</span></label>
   <label><input type="checkbox" name="genre" value="rnb"><span>R&B</span></label>
   <label><input type="checkbox" name="genre" value="metal"><span>Metal</span></label>
  </div></fieldset>
  <div class="setup-options">
   <label>Release era
    <select id="era"><option value="">All eras (recommended)</option><option value="2020">2020s</option><option value="2010">2010s</option><option value="2000">2000s</option><option value="1990">1990s</option><option value="1980">1980s</option><option value="1970">1970s</option><option value="1960">1960s</option></select>
   </label>
   <label>Session length
    <select id="limit"><option value="5">5 songs · Quick</option><option value="10" selected>10 songs · Classic</option><option value="20">20 songs · Marathon</option></select>
   </label>
  </div>
  <button id="start-button" class="primary" type="submit">Start solo challenge <span aria-hidden="true">↗</span></button>
  <p class="fineprint">Choose genres and eras. Your songs stay on the S21 between games.</p>
 </form>
</section>
<section id="game" hidden>
 <div class="stats">
  <div class="stat"><span>ROUND</span><strong id="round-label">01 / 10</strong></div>
  <div class="stat"><span>YOUR SCORE</span><strong id="score-label">0.0 <small>PTS</small></strong></div>
  <div class="stat"><span>CLUE</span><strong id="clue-label">Ready</strong></div>
  <div class="stat right"><button id="finish-button" type="button" class="ghost">End session</button></div>
 </div>
 <div class="game-grid">
  <section class="stage panel">
   <div class="stage-top"><span class="eyebrow">THE MYSTERY TRACK</span><span class="stage-indicator" id="phase-indicator">ON DECK</span></div>
   <div class="record-wrap" id="record-wrap"><div class="record"><div class="record-label"><span>TR</span><small>SOLO 33⅓</small></div></div><span class="record-glow"></span></div>
   <h1 class="stage-title" id="stage-title">Listen closely.</h1>
   <p class="stage-sub" id="stage-sub">Press Play first clue when you're ready.</p>
   <div class="clues" id="clues" aria-label="Seven clue durations"></div>
   <div class="play-controls">
    <button id="play-button" class="primary" type="button">▶ Play first clue</button>
    <button id="replay-button" class="secondary" type="button" hidden>↺ Replay same clue</button>
   </div>
   <p class="playback-help" id="playback-status" role="status" aria-live="polite">Make sure your laptop speakers are on. Music comes through the S21 relay.</p>
  </section>
  <aside class="panel answer">
   <span class="eyebrow">02 / NAME THAT TUNE</span>
   <h2>What do you hear?</h2>
   <p>Every correct field earns +0.5 points. Each wrong guess costs 0.5 points (minimum score: zero). One attempt per field per clue.</p>
   <form id="answer-form">
    <label for="guess-title">Song title</label><input id="guess-title" maxlength="100" autocomplete="off" placeholder="Guess the song title">
    <label for="guess-artist">Artist</label><input id="guess-artist" maxlength="100" autocomplete="off" placeholder="Guess the artist">
    <button id="submit-button" type="submit" class="secondary" disabled>Check my answer</button>
   </form>
   <p id="feedback" class="feedback" role="status" aria-live="polite">Your answers are scored privately by the S21.</p>
   <div id="reveal-card" class="reveal-card" hidden>
    <span class="eyebrow">TRACK REVEALED</span>
    <h3 id="revealed-title"></h3><p id="revealed-artist"></p>
    <button id="next-button" class="primary" type="button">Next song ↗</button>
   </div>
   <button id="reveal-button" class="text-button" type="button" hidden>Give up & reveal song</button>
  </aside>
 </div>
 <section class="panel history" id="history-panel" hidden>
  <div class="history-heading"><div><span class="eyebrow">YOUR SESSION</span><h2>Previously revealed tracks</h2></div><button class="ghost" type="button" id="copy-history">Copy setlist</button></div>
  <ol id="history-list"></ol>
 </section>
</section>
<section id="finished" class="panel finish" hidden>
 <p class="eyebrow">FINAL ENCORE</p><div class="trophy">✦</div>
 <h1>That's a wrap.</h1><p id="finished-summary"></p>
 <div class="finish-actions"><button id="new-game" class="primary" type="button">Play another session ↗</button><button id="copy-recap" class="secondary" type="button">Copy recap</button></div>
 <ol id="finished-tracks" class="finished-tracks"></ol>
</section>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<audio id="music" preload="none"></audio>
</main>
<footer><span class="version-watermark" data-version-watermark>v817 - Made by Bruis</span> · Tune Rush Solo runs on your Galaxy S21 · <a href="https://kalenel.nl/music/">Multiplayer edition</a></footer>
</body></html>

